{
  "name": "esas-web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:watch": "node --watch scripts/run-unit-tests.mjs",
    "assets:check": "node scripts/check-asset-budget.mjs && node scripts/check-static-assets.mjs",
    "source:check": "node scripts/check-source-safety.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run syntax:check && npm run source:check && npm run assets:check && npm run build",
    "syntax:check": "node scripts/check-typescript-syntax.mjs"
  },
  "dependencies": {
    "@types/country-list": "2.1.4",
    "clsx": "2.1.1",
    "country-list": "2.4.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-auto-scroll": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-fade": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "12.23.24",
    "lucide-react": "0.553.0",
    "next": "15.5.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "5.5.7",
    "react-svg-pan-zoom": "3.13.1",
    "sharp": "0.34.5",
    "sonner": "2.0.7",
    "styled-components": "6.3.12",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.0.8",
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "20.19.23",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "eslint": "9.39.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "14.0.0",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3"
  }
